{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reachable row matrix for obstruction certification",
  "type": "object",
  "required": ["prime", "ambient_dim", "reachable_rows"],
  "properties": {
    "prime": {"type": "integer", "minimum": 3},
    "ambient_dim": {"type": "integer", "minimum": 1},
    "reachable_rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "integer"}
      }
    }
  },
  "additionalProperties": true
}
